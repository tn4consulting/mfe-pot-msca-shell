{
  "name": "shell",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/shell/src",
  "tags": ["type:app", "scope:shell"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "production",
      "outputs": ["{workspaceRoot}/dist/apps/shell"],
      "cache": true,
      "inputs": ["production", "^production"],
      "options": {
        "command": "node apps/shell/build/build.mjs",
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "production": {
          "command": "node apps/shell/build/build.mjs"
        },
        "development": {
          "command": "node apps/shell/build/build.mjs --dev"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "node apps/shell/build/serve.mjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/shell/jest.config.cts",
        "tsConfig": "apps/shell/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "shell:build",
        "staticFilePath": "dist/apps/shell/browser",
        "spa": true,
        "port": 4200
      }
    }
  }
}
